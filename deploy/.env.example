# ===== CloudPhone 生产部署配置 =====
# 拷贝为 .env 并按实际修改： cp .env.example .env

# 域名（须提前把 A 记录解析到本服务器公网 IP；80/443 需放行）
DOMAIN=cloud.example.com

# 服务器公网 IP（coturn 生成中继候选地址用，必须填对）
PUBLIC_IP=1.2.3.4

# 强随机密钥（生成： openssl rand -hex 32 / -hex 16）
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
AGENT_KEY=CHANGE_ME_openssl_rand_hex_16

# 初始管理员密码；留空则首启在 backend 容器日志里随机打印一次
ADMIN_PASSWORD=

# TURN 静态凭据（agent 与浏览器都会用到；改成随机值）
TURN_USER=cloudphone
TURN_PASS=CHANGE_ME_random_turn_password
