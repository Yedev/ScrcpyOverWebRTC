# ===== CloudPhone 后端配置 =====

# HTTP / WS 监听端口
PORT=3000

# 运行环境
NODE_ENV=development

# JWT 签名密钥（生产务必改为强随机值，例如 openssl rand -hex 32）
JWT_SECRET=dev-only-change-me
# Token 有效期
JWT_EXPIRES_IN=12h

# 初始管理员密码。留空则首次启动随机生成并打印到控制台（推荐）。
# 设置后用作默认 admin 账户密码。请勿在生产用弱口令。
ADMIN_PASSWORD=

# bcrypt 哈希轮数
BCRYPT_ROUNDS=10

# 是否允许公开注册（false 时只有 admin 能建账号）
ALLOW_PUBLIC_REGISTER=false

# Mock 模式：无真机时注入虚拟设备，跑通全链路
MOCK_DEVICES=true

# adb 可执行路径（接真机时使用）
ADB_PATH=adb

# 设备上 scrcpy-server 推送后的远端路径
SCRCPY_SERVER_REMOTE=/data/local/tmp/scrcpy-server.jar
# 本地 scrcpy-server.jar 路径（接真机前请放置，版本需与控制协议对齐）
SCRCPY_SERVER_LOCAL=./assets/scrcpy-server.jar
# scrcpy-server 版本号，必须与你下载的 jar 版本完全一致（否则设备端会拒绝启动）。
# 控制协议按 scrcpy 2.x 实现，建议用 2.x 版本的 jar。
SCRCPY_VERSION=2.4

# CORS 允许的来源（开发时前端 dev server）
CORS_ORIGIN=http://localhost:5173
