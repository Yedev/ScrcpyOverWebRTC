# cloudphone-agent 配置（也可全部用命令行参数覆盖，见 README）
# 设备唯一标识（必填）
AGENT_ID=my-phone
# 后端信令地址
SIGNALING_URL=ws://127.0.0.1:3000/ws/agent
# 与后端一致的共享密钥
AGENT_KEY=dev-agent-key
# adb
ADB_PATH=adb
ADB_SERIAL=
# scrcpy-server.jar（版本必须与 SCRCPY_VERSION 一致）
SCRCPY_LOCAL_JAR=./scrcpy-server.jar
SCRCPY_REMOTE_JAR=/data/local/tmp/scrcpy-server.jar
SCRCPY_VERSION=2.4
# 视频参数
BITRATE=4000000
MAX_FPS=0
MAX_SIZE=0
# NAT 穿透
STUN_URL=stun:stun.l.google.com:19302
